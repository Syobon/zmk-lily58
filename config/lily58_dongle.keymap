#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3   &kp N4    &kp N5                              &kp N6   &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E    &kp R     &kp T                               &kp Y    &kp U     &kp I     &kp O     &kp P     &kp LBKT
&kp LSHFT  &kp A   &kp S   &kp D    &kp F     &kp G                               &kp H    &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C    &kp V     &kp B    &lt 1 RBKT    &lt 2 BSLH   &kp N    &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp INT1
                           &kp LALT &kp LGUI  &kp DEL  &kp SPACE     &kp RET      &kp BSPC &kp GRAVE &kp EQUAL
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp LC(LA(DEL))  &trans                           &trans  &kp LC(LA(C))  &trans  &trans     &trans     &bt BT_CLR
&trans  &kp F4   &kp F5   &kp F6   &trans           &trans                           &trans  &kp LA(SPACE)  &trans  &trans     &trans     &trans
&trans  &kp F7   &kp F8   &kp F9   &trans           &trans                           &trans  &kp LC(LS(R))  &trans  &kp HOME   &kp UP     &kp END
&trans  &kp F10  &kp F11  &kp F12  &trans           &trans  &trans         &trans    &trans  &trans         &trans  &kp LEFT   &kp DOWN   &kp RIGHT
                          &trans   &trans           &trans  &trans         &trans    &trans  &trans         &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4              &trans &trans &trans &trans &trans &trans
&trans       &trans        &trans        &trans        &trans        &trans                    &trans &trans &trans &trans &trans &trans
&out OUT_USB &out OUT_BLE  &trans        &trans        &trans        &trans                    &trans &trans &trans &trans &trans &trans
&trans       &trans        &trans        &trans        &trans        &trans  &trans    &trans  &trans &trans &trans &trans &trans &kp INT3
                                         &trans        &trans        &trans  &trans    &trans  &trans &trans &trans
            >;
        };
    };
};