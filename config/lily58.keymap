#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: ベース (JIS配列)
        default_layer {
            display-name = "Base";
            bindings = 
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                          &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                           &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT
&kp LSHFT  &kp A   &kp S   &kp D   &kp F   &kp G                           &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C   &kp V   &kp B  &lt 1 LBKT     &lt 2 RBKT  &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp INT1
                  &kp LALT &kp LGUI &kp DEL &kp SPACE                      &kp RET &kp BSPC &kp GRAVE  &kp EQUAL
            >;
        };

        // Layer 1: ファンクション・矢印・マクロ
        lower_layer {
            display-name = "Lower";
            bindings = 
&kp F1   &trans  &kp F2   &kp LC(LA(DEL))  &kp LA(SPACE)  &trans                  &trans  &trans  &kp F3   &trans   &trans   &trans
&kp F4   &trans  &kp F5   &trans   &kp LC(LA(C))  &trans                          &trans  &trans  &kp F6   &trans   &trans   &trans
&kp F7   &trans  &kp F8   &trans   &trans   &kp HOME                              &kp END &trans  &kp F9   &kp UP   &trans   &trans
&kp F10  &trans  &kp F11  &trans   &trans   &kp LEFT  &trans          &trans      &kp RIGHT &trans &kp F12 &kp DOWN &trans   &trans
                 &trans   &trans   &trans   &trans                                &trans   &trans  &trans   &trans
            >;
        };

        // Layer 2: 記号・BLE制御
        raise_layer {
            display-name = "Raise";
            bindings = 
&bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans &trans &trans &trans &trans &trans
&trans       &trans       &trans       &trans       &trans       &trans         &trans &trans &trans &trans &trans &trans
&out OUT_USB &out OUT_BLE &trans       &trans       &trans       &trans         &trans &trans &trans &trans &trans &trans
&trans       &trans       &trans       &trans       &trans       &trans  &trans  &trans &trans &trans &trans &trans &trans &kp INT3
                          &trans       &trans       &trans       &trans         &trans &trans &trans &trans
            >;
        };

        // Layer 3: 未使用 (将来用)
        adjust_layer {
            display-name = "Adjust";
            bindings = 
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans
            >;
        };
    };
};